# ============================================================================
#  Polymarket Weather Bot -- copy to `.env` and fill in.
#  Everything here has a safe default; the bot starts in PAPER mode.
# ============================================================================

# ---------------------------------------------------------------- mode ----
# paper = simulate fills locally, never touches the chain (default)
# live  = place real orders. Also requires /arm in Telegram every run.
TRADING_MODE=paper

# ------------------------------------------------------------ telegram ----
# 1. Talk to @BotFather -> /newbot -> copy the token here.
# 2. Message your new bot, then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# optional extra user ids allowed to run commands, comma separated
TELEGRAM_ALLOWED_IDS=

# ----------------------------------------------------------- polymarket ---
# ONLY needed for TRADING_MODE=live. Leave blank for paper trading.
# PRIVATE_KEY is the EOA that controls your Polymarket account.
# FUNDER_ADDRESS is the deposit/proxy address shown on polymarket.com.
PRIVATE_KEY=
FUNDER_ADDRESS=
# 1 = email/magic login wallet, 2 = browser wallet (MetaMask etc.)
SIGNATURE_TYPE=1
# Leave blank -- derived from PRIVATE_KEY on first run.
CLOB_API_KEY=
CLOB_SECRET=
CLOB_PASSPHRASE=

# ------------------------------------------------------------ strategies --
ENABLE_FORECAST_EDGE=true
ENABLE_COPY_TRADING=true

# ----------------------------------------------------------------- risk ---
# Start small. These caps are the only thing between a bug and your balance.
BANKROLL_USDC=500
MAX_POSITION_USDC=25            # per market
MAX_DAILY_NOTIONAL_USDC=200     # per UTC day across all markets
MAX_OPEN_POSITIONS=12
MAX_DAILY_LOSS_USDC=75          # trips the kill switch for the day
KELLY_FRACTION=0.25             # fractional Kelly; 1.0 would be reckless

# -------------------------------------------------------- forecast edge ---
MIN_EDGE=0.06                   # required model_prob - ask
MIN_PRICE=0.03
MAX_PRICE=0.95
MAX_SPREAD=0.06                 # skip illiquid books
MIN_MARKET_VOLUME=2000

# ---------------------------------------------------------- copy trading --
# Leader wallets to mirror. Add / delete / edit them right here, then send
# /reload in Telegram -- no restart needed.
#
#   format:  wallet[:name][:weight]   comma separated
#   weight MULTIPLIES COPY_SCALE for that wallet -- it is a relative dial,
#     not the size itself. 1.0 = the full COPY_SCALE, 0.5 = half of it.
#     To trade smaller overall, lower COPY_SCALE; do NOT set weight to 0.05,
#     that would give 0.05 x 0.05 = 0.25% of the leader's notional.
#   name is only a label for alerts; omit it and the address is used
#
# Examples:
#   COPY_WALLETS=0xabc...123                      one wallet, default weight
#   COPY_WALLETS=0xabc...123:whale                named
#   COPY_WALLETS=0xabc...123:whale:0.5            named, half size
#   COPY_WALLETS=0xabc...123:0.5                  weight only, no name
#
# Leave COPY_WALLETS empty to fall back to data/top_traders.json instead.
COPY_WALLETS=0xca1f9b9d67d947c8007d9814e8f9d6045cccd282:KickstandBot:1.0,0xaa7a74b8c754e8aacc1ac2dedb699af0a3224d23:securebet:1.0

COPY_SCALE=0.05                 # mirror 5% of the leader's notional
COPY_MAX_AGE_SEC=900            # ignore leader trades older than this
COPY_MIN_LEADER_NOTIONAL=50

# ---------------------------------------------------------------- loops ---
SCAN_INTERVAL_SEC=300
COPY_POLL_INTERVAL_SEC=45
HEARTBEAT_HOUR_UTC=12

LOG_LEVEL=INFO
